# InterviewAI — production configuration template.
#
#   cp .env.production.example .env.production
#
# Every value below is validated at import. A misconfigured production deploy
# refuses to start rather than running quietly insecure, so if the container
# exits immediately, read the traceback — it names the setting.

# Turns on every fail-fast check. Must be exactly "production".
ENVIRONMENT=production

# Generate with:  openssl rand -base64 48
# Must be 32+ chars and not one of {dev-secret, changeme, secret}.
# Rotating this invalidates every issued token.
JWT_SECRET_KEY=CHANGE_ME_openssl_rand_base64_48

# Overridden by docker-compose with the internal hostnames. Set these for a
# non-Docker deploy (managed Postgres/Redis).
DATABASE_URL=postgresql://user:password@host:5432/interviewai
REDIS_URL=redis://host:6379/0

# Required. https://console.groq.com/keys
GROQ_API_KEY=CHANGE_ME

# Optional. Text-to-speech returns 503 when unset rather than failing hard —
# there is deliberately no fallback key.
ELEVENLABS_API_KEY=

# The browser origin(s) that will call this API, comma-separated.
# "*" is rejected outright in production.
CORS_ALLOW_ORIGINS=https://your-domain.com

# Must be false in production; the app refuses to boot otherwise.
DEBUG=false

# --- Optional, shown with their defaults -----------------------------------

# JWT lifetime. Deliberately longer than SESSION_TTL_SECONDS so a token can
# never expire mid-interview; /api/auth/refresh renews it during long sessions.
ACCESS_TOKEN_EXPIRE_MINUTES=480

# How long a live interview survives in Redis (6 hours). Once a report has been
# generated it is served from Postgres, so this is not the bound on retrieval.
SESSION_TTL_SECONDS=21600

MAX_UPLOAD_SIZE_MB=10
LOG_LEVEL=INFO

# Set to 1 to skip the background YOLO warm-up at startup. Leave unset in
# production: warming it means the first candidate does not pay for the load.
# SKIP_MODEL_WARMUP=0

# Groq chat model. Override if the provider retires the default.
GROQ_MODEL=openai/gpt-oss-120b

# Reserved output tokens. Groq counts this against the per-minute limit
# before the call runs, so keep it under your tier ceiling.
GROQ_MAX_TOKENS=4000
