# Copy to .env and fill in. Never commit the real .env.

# --- Required ---------------------------------------------------------------
# SQLAlchemy connection URL.
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/interviewai

# Groq API key used for question generation and answer evaluation.
GROQ_API_KEY=

# --- Auth -------------------------------------------------------------------
# REQUIRED when ENVIRONMENT=production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Left unset in development, a random per-process value is used, which means
# tokens stop working after a restart.
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Optional ---------------------------------------------------------------
# ElevenLabs text-to-speech. If unset, /api/generate-speech returns 503 and the
# frontend falls back to the browser's built-in speech synthesis.
ELEVENLABS_API_KEY=

# Redis for interview session state. Without it the app falls back to an
# in-process dict, which does not work with more than one worker.
REDIS_URL=redis://localhost:6379/0
SESSION_TTL_SECONDS=21600

# development | production
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# Comma-separated allowlist. "*" is rejected when ENVIRONMENT=production.
CORS_ALLOW_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

MAX_UPLOAD_SIZE_MB=10
